# Preserve exact upstream bytes for Steam Audio artifacts verified by SHA-256.
cosmos/steamaudio-sys/phonon/LICENSE.md -text whitespace=-blank-at-eol
cosmos/steamaudio-sys/phonon/THIRDPARTY.md -text whitespace=-blank-at-eol
cosmos/steamaudio-sys/phonon/TRADEMARK_RIGHTS.md -text whitespace=-blank-at-eol
cosmos/steamaudio-sys/phonon/phonon.h -text whitespace=-blank-at-eol
cosmos/steamaudio-sys/phonon/phonon_version.h -text whitespace=-blank-at-eol

# The Web compatibility test compares this vendored decoder byte-for-byte
# with its pinned npm package, so Windows checkouts must preserve LF endings.
web_client/vendor/stb-vorbis.js text eol=lf

# Management scripts are uploaded from Windows and executed directly on Linux.
server/sc.sh text eol=lf
deployment/marco-vps/*.sh text eol=lf

# Keep the documented byte hashes stable on Linux and Windows checkouts.
server/games/humanitycards/humanity_packs_es.json -text
server/games/humanitycards/humanity_black_cards_pt_br.json -text
server/games/humanitycards/humanity_white_cards_pt_br.json -text
