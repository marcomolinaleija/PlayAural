admin-archivos-cuota = Pending upload quota per account: { $limite } MiB
admin-archivos-introducir-limite = Enter a whole number of MiB. Per file: 1 to 128. Pending quota: at least the file limit and at most 256.
admin-archivos-local = Local storage
admin-archivos-s3 = Remote S3 / Backblaze B2 storage
