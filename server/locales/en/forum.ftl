forum-pinned = Pinned
forum-closed = Closed
forum-read = Read
forum-unread-count = { $count } unread
forum-reply = Write a reply
forum-save = Save discussion
forum-unsave = Remove from saved discussions
forum-saved-feedback = Discussion saved. Find it in Saved discussions.
forum-unsaved-feedback = Discussion removed from your saved discussions.
forum-continue = Continue from the first unread message
forum-next-unread = Read the next unread message
forum-edit = Edit message
forum-edited = Edited { $age }
forum-deleted-account = Deleted account
forum-hidden-post = This message has been hidden by a moderator.
forum-closed-help = This discussion is closed. You can read it, but new replies are disabled.
forum-close = Close discussion
forum-reopen = Reopen discussion
forum-pin = Pin discussion
forum-unpin = Unpin discussion
forum-hide-post = Hide message
forum-restore-post = Restore message
forum-moderation-prompt = { $action } in “{ $title }”? This change applies to everyone.
forum-moderation-saved = The moderation change was saved.
forum-search-prompt = Search titles and messages (2–100 characters).
forum-search-query = Search: { $query }
