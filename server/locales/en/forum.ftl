forum-heading = Forum
forum-description = Read community discussions, ask questions, and share ideas.
forum-intro = Choose a category or catch up on recent discussions. Open a message to read it in full.
forum-recent = Recent activity
forum-unread = Unread discussions
forum-saved = Saved discussions
forum-search = Search discussions
forum-category-general = Community
forum-category-help = Questions and help
forum-category-ideas = Ideas and feedback
forum-category-row = { $name } — { forum-topic-count }
