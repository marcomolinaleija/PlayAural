mexicopoly-event-ended = Special event ended: { $event }. Rents return to normal.
mexicopoly-event-ended-brief = Event ended: { $event }.
mexicopoly-status-special-event = Active special event: { $event } ({ $turns } turns remaining).
mexicopoly-action-vandalize-property = Vandalize opponent property
mexicopoly-desc-vandalize-property = Pay a covert crew to vandalize an unmortgaged opponent property, cutting its rent in half for 3 turns and blocking new construction; the owner may try to denounce the culprit.
mexicopoly-prompt-vandalize-property = Choose which opponent property to vandalize
mexicopoly-vandalize-property-option = { $property } owned by { $owner } (cost: { $cost })
mexicopoly-error-already-vandalized-turn = You already vandalized a property this turn.
mexicopoly-error-no-vandalizable-properties = There are no eligible opponent properties to vandalize right now.
mexicopoly-error-vandalize-needs-cash = You need at least { $cost } to vandalize a property; you have { $cash }.
mexicopoly-error-property-vandalized = This property is vandalized and cannot build new developments for { $turns } more turns.
mexicopoly-you-vandalize-property = You secretly pay { $cost } to vandalize { $owner }'s { $property }. The damage will be discovered when their turn begins. You have { $cash } left.
mexicopoly-you-vandalize-property-brief = Secretly vandalized { $owner }'s { $property } for { $cost }.
mexicopoly-your-property-vandalized = Someone vandalized your property { $property }! Its rent is cut by 50% for { $turns } turns. You may denounce who you think is responsible (if you guess right they pay damages and repair it; if you accuse falsely you pay a penalty) or let it go.
mexicopoly-your-property-vandalized-brief = Your { $property } was vandalized! Denounce a suspect or let it go.
mexicopoly-property-vandalized = Someone vandalized { $owner }'s { $property }! Its rent drops by 50% for { $turns } turns while { $owner } looks for the culprit.
mexicopoly-property-vandalized-brief = { $owner }'s { $property } was vandalized!
mexicopoly-phase-vandalism-decision = vandalism response
mexicopoly-action-denounce-vandal = Denounce suspect
mexicopoly-desc-denounce-vandal = Formally accuse the player you believe vandalized your property. If you are right, they pay proportional damages and repair the property; if you are wrong, you pay them for a false accusation.
mexicopoly-prompt-denounce-vandal = Who do you denounce for vandalizing your property?
mexicopoly-vandalism-suspect-option = Denounce { $suspect } (collect { $reward } if right; pay { $risk } if wrong)
mexicopoly-action-skip-vandalism-denounce = Do not denounce and absorb damage
mexicopoly-desc-skip-vandalism-denounce = Avoid the risk of a false-accusation fine, leaving the property vandalized for 3 turns.
mexicopoly-timeout-skip-denounce = skip filing a vandalism denunciation
mexicopoly-you-denounce-correct = You nailed it! Security cameras confirm { $suspect } vandalized { $property }. The damage is repaired immediately and { $suspect } must pay you { $penalty } in damages.
mexicopoly-you-denounce-correct-brief = Correct! { $suspect } repairs { $property } and pays you { $penalty }.
mexicopoly-you-were-caught-vandalizing = Busted! { $victim } correctly denounced you for vandalizing { $property }. The damage is repaired and you must pay { $penalty } in damages.
mexicopoly-you-were-caught-vandalizing-brief = Busted! Pay { $penalty } to { $victim } and repair { $property }.
mexicopoly-player-denounces-correct = { $victim } guessed right! { $suspect } vandalized { $property }, repairs the damage, and must pay { $penalty }.
mexicopoly-player-denounces-correct-brief = { $victim } catches { $suspect }: { $penalty } fine.
mexicopoly-you-denounce-false = False accusation! { $suspect } had a verified alibi for { $property }. You must pay { $penalty } for defamation and your property remains vandalized.
mexicopoly-you-denounce-false-brief = False accusation! Pay { $penalty } to { $suspect }; { $property } stays damaged.
mexicopoly-you-were-falsely-accused = { $accuser } falsely denounced you for vandalizing { $property }, but your alibi clears you and they must pay you { $penalty } in damages.
mexicopoly-you-were-falsely-accused-brief = { $accuser } falsely accused you and pays { $penalty }.
mexicopoly-player-denounces-false = { $accuser } falsely accused { $suspect } over { $property }! { $accuser } must pay { $penalty } and the property stays vandalized.
mexicopoly-player-denounces-false-brief = False accusation by { $accuser } against { $suspect }: pays { $penalty }.
mexicopoly-you-skip-denounce = You decide not to denounce anyone over { $property }; it stays vandalized for { $turns } turns.
mexicopoly-player-skips-denounce = { $player } decides not to file a denunciation over { $property }; it stays vandalized for { $turns } turns.
mexicopoly-you-skip-denounce-brief = No denunciation over { $property }.
mexicopoly-player-skips-denounce-brief = { $player } files no denunciation over { $property }.
mexicopoly-debt-vandalism-caught = damages for vandalizing another player's property
mexicopoly-debt-false-accusation = a fine for a false vandalism accusation
mexicopoly-vandalism-repaired = Repairs at { $property } are complete; it collects full rent again.
mexicopoly-vandalism-repaired-brief = { $property } repaired; normal rent restored.
mexicopoly-property-state-vandalized-suffix = , vandalized ({ $turns } turns, -50% rent)
mexicopoly-status-vandalized-property = Vandalized property: { $property } ({ $turns } turns left at half rent).
